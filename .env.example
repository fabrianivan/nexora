# ============================================================================
# NEXORA v2.0 — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# IMPORTANT: Never prefix secret keys with NEXT_PUBLIC_. All AI & DB calls run
# strictly on the server (Next.js App Router API routes).

# 1. AI Engine Mode ('demo' | 'live' | auto-detect based on GEMINI_API_KEY)
# - If GEMINI_API_KEY is empty or NEXORA_AI_MODE=demo, Nexora runs DemoEngine
#   (100% deterministic, zero external API calls, works offline).
# - If GEMINI_API_KEY is set, Nexora runs LiveEngine (Gemini 2.5 Flash) with
#   7s timeout, retry backoff, and automatic fallback to DemoEngine.
NEXORA_AI_MODE=demo
GEMINI_API_KEY=

# 2. Storage Repository (Optional MySQL / Cloud SQL)
# - If MYSQL_URL is unset, Nexora automatically uses InMemoryWorkspaceRepository
#   seeded with the multi-entity sample dataset.
# - Example: mysql://nexora_user:ENCODED_PASSWORD@127.0.0.1:3306/nexora
MYSQL_URL=

# 3. Optional Access Token Gate (Session HMAC Auth)
# - Leave empty for frictionless 1-click Smart Demo Mode.
# - Set both values to enforce token login before workspace API access.
NEXORA_ACCESS_TOKEN=
NEXORA_SESSION_SECRET=

# 4. Planned Google Cloud Enterprise Integrations (Roadmap / Simulation Status)
# - Currently simulated locally on the server and labeled honestly in the UI
#   ("Dihitung lokal (simulasi BigQuery)").
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast2
DOCUMENT_AI_PROCESSOR_ID=
BIGQUERY_DATASET=nexora_tax_analytics
VERTEX_AI_LOCATION=asia-southeast1
