# Optional: enables unverified Gemini Copilot responses.
# Keep server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Required for workspace persistence. Keep credentials server-side only.
# Example: mysql://nexora_user:ENCODED_PASSWORD@127.0.0.1:3306/nexora
MYSQL_URL=

# Protects workspace and AI endpoints. Generate each value independently and
# keep them server-side only. The browser session expires after 8 hours.
NEXORA_ACCESS_TOKEN=
NEXORA_SESSION_SECRET=

# Reserved for future integrations. The current document scanner is simulation-only.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional analytics integration. Fraud rules always run locally.
BIGQUERY_DATASET=
VERTEX_AI_LOCATION=us-central1
