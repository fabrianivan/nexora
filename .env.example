# Mode Live: required for Gemini Copilot and Gemini Vision extraction.
# Keep server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional Google Cloud configuration. The current scanner uses Gemini Vision;
# these values declare a Document AI processor for a future/custom adapter.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional analytics integration. Fraud rules always run locally.
BIGQUERY_DATASET=
VERTEX_AI_LOCATION=us-central1
