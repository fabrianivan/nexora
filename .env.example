# Live AI: Copilot answers, the case investigation agent (function calling) and
# document extraction (Gemini vision). Without a key every AI surface runs the
# local deterministic engine and is labelled "Simulasi lokal · offline".
# Keep server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: model id (default gemini-2.5-flash). Change it here, not in code.
GEMINI_MODEL=
# Optional: per-call timeout in ms (default 20000 for the AI routes).
AI_ENGINE_TIMEOUT_MS=

# Required for workspace persistence. Keep credentials server-side only.
# Example: mysql://nexora_user:ENCODED_PASSWORD@127.0.0.1:3306/nexora
MYSQL_URL=

# Optional Google Cloud configuration. The current scanner uses Gemini Vision;
# these values declare a Document AI processor for a future/custom adapter.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional analytics integration. Fraud rules always run locally.
BIGQUERY_DATASET=
VERTEX_AI_LOCATION=us-central1
